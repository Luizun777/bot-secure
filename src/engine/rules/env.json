{
  "version": 1,
  "rules": [
    {
      "id": "env-secret-assignment",
      "category": "secret",
      "severity": "HIGH",
      "description": {
        "es": "Variable de entorno con secreto literal",
        "en": "Environment variable with a literal secret"
      },
      "keywords": [
        "password",
        "passwd",
        "pwd",
        "secret",
        "token",
        "api_key",
        "apikey",
        "api-key",
        "private_key",
        "access_key"
      ],
      "regex": "^\\s*(?:-\\s*|ENV\\s+|ARG\\s+|export\\s+|set\\s+|\\$env:)?[\\w.-]*(PASSWORD|PASSWD|PWD|SECRET|TOKEN|API_?KEY|PRIVATE_KEY|ACCESS_KEY)[\\w.-]*\\s*[:=]\\s*(?!\\$)(?!\\{\\{)(?!%)['\"]?([^\\s'\"#]{6,})",
      "flags": "i",
      "secretGroup": 2,
      "nameGroup": 1,
      "family": "env",
      "maskKind": "secret",
      "remediation": {
        "kind": "secret"
      }
    },
    {
      "id": "config-secret-key",
      "category": "secret",
      "severity": "HIGH",
      "description": {
        "es": "Clave sensible con valor literal en configuración",
        "en": "Sensitive configuration key with a literal value"
      },
      "keywords": [],
      "minLen": 4,
      "family": "config",
      "maskKind": "secret",
      "scope": "config",
      "remediation": {
        "kind": "secret"
      }
    }
  ]
}
