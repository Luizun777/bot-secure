    {
      "id": "private-key-pem",
      "category": "secret",
      "severity": "CRITICAL",
      "description": {
        "es": "Clave privada en formato PEM",
        "en": "PEM private key block"
      },
      "keywords": [
        "-----begin"
      ],
      "regex": "(-----BEGIN (?:RSA |DSA |EC |OPENSSH |ENCRYPTED |PGP )?PRIVATE KEY(?: BLOCK)?-----)",
      "secretGroup": 1,
      "family": "prefixed",
      "maskKind": "pem",
      "remediation": {
        "kind": "secret",
        "envVar": "PRIVATE_KEY"
      }
    },
