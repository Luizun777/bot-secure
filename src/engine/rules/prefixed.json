      "regex": "(https:\\/\\/(?:canary\\.|ptb\\.)?discord(?:app)?\\.com\\/api\\/webhooks\\/\\d{5,}\\/[A-Za-z0-9_-]{20,})",
      "secretGroup": 1,
      "family": "prefixed",
      "maskKind": "secret",
      "remediation": {
        "kind": "url",
        "envVar": "DISCORD_WEBHOOK_URL"
