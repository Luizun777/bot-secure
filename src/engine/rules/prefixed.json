{
  "version": 1,
  "rules": [
    {
      "id": "aws-access-key-id",
      "category": "secret",
      "severity": "CRITICAL",
      "description": {
        "es": "Identificador de clave de acceso de AWS",
        "en": "AWS access key id"
      },
      "keywords": [
        "akia",
        "asia",
        "abia",
        "acca"
      ],
      "regex": "\\b((?:AKIA|ASIA|ABIA|ACCA)[A-Z0-9]{16})\\b",
      "secretGroup": 1,
      "family": "prefixed",
      "maskKind": "token",
      "remediation": {
        "kind": "secret",
        "envVar": "AWS_ACCESS_KEY_ID"
      }
    },
    {
      "id": "aws-secret-access-key",
      "category": "secret",
      "severity": "CRITICAL",
      "description": {
        "es": "Clave secreta de AWS junto a una clave contextual",
        "en": "AWS secret access key near a context keyword"
      },
      "keywords": [
        "aws"
      ],
      "regex": "aws[\\w.-]{0,24}(?:secret|access[_-]?key)[\\w.-]{0,24}[\"'\\s:=]{1,10}([A-Za-z0-9/+]{40})(?![A-Za-z0-9/+=])",
      "flags": "i",
      "secretGroup": 1,
      "entropy": 3.5,
      "family": "prefixed",
      "maskKind": "secret",
      "remediation": {
        "kind": "secret",
        "envVar": "AWS_SECRET_ACCESS_KEY"
      }
    },
    {
      "id": "github-token",
      "category": "secret",
      "severity": "HIGH",
      "description": {
        "es": "Token de GitHub (ghp_/gho_/ghu_/ghs_/ghr_)",
        "en": "GitHub token (ghp_/gho_/ghu_/ghs_/ghr_)"
      },
      "keywords": [
        "ghp_",
        "gho_",
        "ghu_",
        "ghs_",
        "ghr_"
      ],
      "regex": "\\b(gh[pousr]_[A-Za-z0-9]{36})\\b",
      "secretGroup": 1,
      "family": "prefixed",
      "maskKind": "token",
      "remediation": {
        "kind": "secret",
        "envVar": "GITHUB_TOKEN"
      }
    },
    {
      "id": "github-fine-grained-pat",
      "category": "secret",
      "severity": "HIGH",
      "description": {
        "es": "Token de acceso personal granular de GitHub",
        "en": "GitHub fine-grained personal access token"
      },
      "keywords": [
        "github_pat_"
      ],
      "regex": "\\b(github_pat_[A-Za-z0-9_]{60,100})\\b",
      "secretGroup": 1,
      "family": "prefixed",
      "maskKind": "token",
      "remediation": {
        "kind": "secret",
        "envVar": "GITHUB_TOKEN"
      }
    },
    {
      "id": "gitlab-pat",
      "category": "secret",
      "severity": "HIGH",
      "description": {
        "es": "Token de acceso personal de GitLab",
        "en": "GitLab personal access token"
      },
      "keywords": [
        "glpat-",
        "gldt-"
      ],
      "regex": "\\b((?:glpat|gldt)-[A-Za-z0-9_-]{20,})",
      "secretGroup": 1,
      "family": "prefixed",
      "maskKind": "token",
      "remediation": {
        "kind": "secret",
        "envVar": "GITLAB_TOKEN"
      }
    },
    {
      "id": "npm-token",
      "category": "secret",
      "severity": "HIGH",
      "description": {
